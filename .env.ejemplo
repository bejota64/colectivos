# Copiar este archivo como ".env" y cambiar las contrasenas.
# El archivo .env NUNCA se sube a Git (esta en .gitignore).

# Cuentas duenas de las bases: solo para los scripts de inicio y para
# limpiar datos en las pruebas de integracion. La API NO las usa.
POSTGRES_USUARIO=colectivos_admin
POSTGRES_CONTRASENA=cambiar-por-una-contrasena-larga

MONGO_USUARIO=colectivos_admin
MONGO_CONTRASENA=cambiar-por-otra-contrasena-larga

# Cuentas de la API, con permisos minimos (las crean los scripts de
# bd/*/inicio la primera vez que se levantan las bases).
POSTGRES_API_USUARIO=colectivos_api
POSTGRES_API_CONTRASENA=cambiar-por-una-tercera-contrasena-larga

MONGO_API_USUARIO=colectivos_api
MONGO_API_CONTRASENA=cambiar-por-una-cuarta-contrasena-larga
