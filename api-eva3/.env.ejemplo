# Copiar como ".env" dentro de la carpeta api-eva3/. Nunca se sube a Git.

NODE_ENV=development
PUERTO=3000

# La API se conecta con las cuentas de permisos minimos: mismo usuario y
# contrasena que POSTGRES_API_* y MONGO_API_* del .env de docker-compose.
URL_POSTGRES=postgresql://colectivos_api:cambiar-por-una-tercera-contrasena-larga@localhost:5432/colectivos
URL_MONGO=mongodb://colectivos_api:cambiar-por-una-cuarta-contrasena-larga@localhost:27017/colectivos?authSource=colectivos

# Solo para las pruebas de integracion (npm run test:e2e): preparan y borran
# sus datos con las cuentas duenas (POSTGRES_USUARIO y MONGO_USUARIO).
URL_POSTGRES_ADMIN=postgresql://colectivos_admin:cambiar-por-una-contrasena-larga@localhost:5432/colectivos
URL_MONGO_ADMIN=mongodb://colectivos_admin:cambiar-por-otra-contrasena-larga@localhost:27017/?authSource=admin

# Peticiones por minuto que acepta la API desde una misma IP. Dejar en 100.
# Solo se sube (por ejemplo a 5000) mientras corre la prueba de carga con k6.
LIMITE_GENERAL_POR_MINUTO=100

# Secreto para firmar los tokens. Minimo 32 caracteres aleatorios.
# Generar uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SECRETO_JWT=reemplazar-por-un-secreto-aleatorio-de-al-menos-32-caracteres

# Opcional. Solo si la web corre en otro puerto durante el desarrollo, por ejemplo:
# ORIGEN_WEB=http://localhost:5173
